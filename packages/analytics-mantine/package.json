{
  "name": "@archbase/analytics-mantine",
  "version": "4.8.0",
  "description": "Mantine components and compositions for Archbase Analytics",
  "license": "MIT",
  "author": "Edson Martins",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    }
  },
  "typesVersions": {
    "*": {
      "charts": [
        "./dist/charts.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "typescript",
    "analytics",
    "mantine",
    "explorer",
    "archbase"
  ],
  "dependencies": {
    "@archbase/analytics-core": "workspace:*"
  },
  "peerDependencies": {
    "@mantine/core": "9.6.0",
    "@mantine/dates": "9.6.0",
    "@mantine/hooks": "9.6.0",
    "@tabler/icons-react": "^3.27.0",
    "react": "^18.3.0 || ^19.2.0",
    "react-dom": "^18.3.0 || ^19.2.0"
  },
  "peerDependenciesMeta": {
    "@mantine/charts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mantine/charts": "9.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.1",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^2.1.8"
  }
}
