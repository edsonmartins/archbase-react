      },
      "onValidationChange": {
        "name": "onValidationChange",
        "required": false,
        "type": { "name": "(result: ArchbasePasswordValidationResult) => void" },
        "description": "Evento disparado sempre que o resultado da validação muda"
      },
      "style": {
        "name": "style",
        "required": false,
        "type": { "name": "CSSProperties" },
        "description": "Estilo do container"
