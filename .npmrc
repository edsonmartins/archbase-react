# O registry do escopo @archbase NÃO fica aqui de propósito.
#
# Enquanto este arquivo apontava @archbase para o Verdaccio interno, o desvio
# valia para todo mundo que clonasse o repositório e vencia até a flag
# --registry da linha de comando (escopo tem precedência). O resultado foi
# publicação indo para o Verdaccio achando que ia para o npm, e verificação
# lendo o Verdaccio achando que lia o npm — sem nenhum erro em qualquer dos
# dois casos.
#
# Quem usa o Verdaccio configura na sua máquina, fora do versionamento:
#   npm config set @archbase:registry http://192.168.1.110:4873
#
# O fluxo de debug (scripts/publish-debug.js) não depende disto: ele passa
# --registry explicitamente em cada comando.
registry=https://registry.npmjs.org

# Required for Storybook 10
node-linker=hoisted
shamefully-hoist=true
